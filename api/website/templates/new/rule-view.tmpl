{{define "rule"}}
{{template "header" .}}
{{$home := .RuleHome}}
{{with .Rule}}
<div class="q2a-page-head">
	<div class="min-w-0">
		<nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a href="{{$home.RootURL}}">{{$home.Root}}</a></li><li class="breadcrumb-item"><a href="{{$home.URL}}">{{$home.Name}}</a></li><li class="breadcrumb-item"><a href="{{$home.RulesURL}}">Rules</a></li><li class="breadcrumb-item active q2a-mono" aria-current="page">{{printf "%.8s" .GetUuid}}</li></ol></nav>
		<h1 class="text-truncate">
			<span class="badge text-bg-secondary align-middle fs-6">{{.GetType}}</span>
			{{with .GetDescription}}{{join . " "}}{{else}}Rule{{end}}
			{{if .GetDisabled}}<span class="badge text-bg-warning align-middle fs-6">disabled</span>{{end}}
		</h1>
	</div>
	<div class="d-flex gap-2">
		<a class="btn btn-sm btn-primary" href="/rules/{{.GetUuid}}/edit"><i class="bi bi-pencil me-1"></i>Edit</a>
		<form method="post" action="/rules/{{.GetUuid}}/delete" data-q2a-confirm="Delete this rule?">
			<button class="btn btn-sm btn-outline-danger" type="submit"><i class="bi bi-trash me-1"></i>Delete</button>
		</form>
	</div>
</div>

{{with $.Notice}}<div class="alert alert-{{.Class}} alert-dismissible fade show" role="status">{{.Text}}<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div>{{end}}

<div class="row g-3">
	<div class="col-12 col-xl-6">
		<div class="q2a-panel h-100">
			<div class="q2a-panel-head">Matches players when all of these match</div>
			<div class="q2a-panel-body">
				<dl class="q2a-kv">
					{{with .GetAddress}}<dt>Addresses</dt><dd class="q2a-mono">{{range .}}<div>{{.}}</div>{{end}}</dd>{{end}}
					{{with .GetName}}<dt>Names</dt><dd class="q2a-mono">{{range .}}<div>{{.}}</div>{{end}}</dd>{{end}}
					{{with .GetHostname}}<dt>Hostnames</dt><dd class="q2a-mono">{{range .}}<div>{{.}}</div>{{end}}</dd>{{end}}
					{{with .GetClient}}<dt>Clients</dt><dd class="q2a-mono">{{range .}}<div>{{.}}</div>{{end}}</dd>{{end}}
					{{with .GetUserInfo}}<dt>Userinfo</dt><dd class="q2a-mono">{{range .}}<div>{{.GetProperty}} = {{.GetValue}}</div>{{end}}</dd>{{end}}
					{{if .GetVpn}}<dt>VPN</dt><dd>connecting through a VPN</dd>{{end}}
				</dl>
				<p class="small text-body-secondary mt-3 mb-0">Names and hostnames are case-insensitive regular expressions.</p>
			</div>
		</div>
	</div>
	<div class="col-12 col-xl-6">
		<div class="q2a-panel h-100">
			<div class="q2a-panel-head">Details</div>
			<div class="q2a-panel-body">
				<dl class="q2a-kv">
					<dt>Applies to</dt><dd>{{if eq $home.Kind "group"}}every server in the group <a href="{{$home.URL}}">{{$home.Name}}</a>{{else}}<a href="{{$home.URL}}">{{$home.Name}}</a>{{end}}</dd>
					<dt>Created</dt><dd>{{with .GetCreationTime}}{{datetime .}}{{else}}-{{end}}</dd>
					<dt>Expires</dt><dd>{{with .GetExpirationTime}}{{datetime .}}{{else}}never{{end}}</dd>
					{{if eq .GetType.String "STIFLE"}}<dt>Stifle length</dt><dd>{{.GetStifleLength}} seconds</dd>{{end}}
					{{with .GetMessage}}<dt>Message</dt><dd>{{range .}}<div>{{.}}</div>{{end}}</dd>{{end}}
					{{with .GetTimespec}}{{if or .GetBefore .GetAfter .GetEvery .GetPlayTime}}<dt>Timing</dt><dd class="q2a-mono small">{{with .GetBefore}}before {{.}} {{end}}{{with .GetAfter}}after {{.}} {{end}}{{with .GetEvery}}every {{.}} {{end}}{{with .GetPlayTime}}playtime {{.}}{{end}}</dd>{{end}}{{end}}
					<dt>ID</dt><dd class="q2a-mono">{{.GetUuid}}</dd>
				</dl>
			</div>
		</div>
	</div>
</div>
{{end}}
{{template "footer" .}}
{{end}}
