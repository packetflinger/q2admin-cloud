{{define "profile"}}
{{template "header" .}}
{{with .SessionUser}}
<div class="q2a-page-head">
	<div class="d-flex align-items-center gap-3 min-w-0">
		{{if .GetSession.GetAvatar}}<img src="{{.GetSession.GetAvatar}}" class="rounded-circle" width="56" height="56" alt="">{{else}}<i class="bi bi-person-circle fs-1 text-body-secondary"></i>{{end}}
		<div class="min-w-0">
			<h1 class="text-truncate">{{displayName .}}</h1>
			<div class="text-body-secondary small">{{.GetEmail}}</div>
		</div>
	</div>
	<a class="btn btn-sm btn-outline-secondary" href="/sign-out"><i class="bi bi-box-arrow-right me-1"></i>Sign out</a>
</div>

{{with $.Notice}}<div class="alert alert-{{.Class}} alert-dismissible fade show" role="status">{{.Text}}<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div>{{end}}

<div class="row g-3">
	<div class="col-12 col-xl-6">
		<div class="q2a-panel h-100">
			<div class="q2a-panel-head">Account</div>
			<div class="q2a-panel-body">
				<form class="mb-4" method="post" action="/me">
					{{if $.FormError}}<div class="alert alert-danger" role="alert">{{$.FormError}}</div>{{end}}
					<label class="form-label" for="profile-name">Name</label>
					<div class="input-group">
						<input type="text" class="form-control" id="profile-name" name="name" maxlength="32" value="{{if $.FormError}}{{$.Form.Get "name"}}{{else}}{{.GetName}}{{end}}" placeholder="{{displayName .}}" aria-describedby="profile-name-help">
						<button class="btn btn-primary" type="submit">Save</button>
					</div>
					<div class="form-text" id="profile-name-help">What other people see, for example on console commands you send. Leave empty to show the start of your email address.</div>
				</form>
				<dl class="q2a-kv">
					<dt>Email</dt><dd>{{.GetEmail}}</dd>
					<dt>Status</dt><dd>{{if .GetDisabled}}<span class="badge text-bg-danger">disabled</span>{{else}}<span class="badge text-bg-success">active</span>{{end}}</dd>
					{{with .GetDescription}}<dt>About</dt><dd>{{.}}</dd>{{end}}
					<dt>Servers</dt><dd><a href="/my-servers">{{len $.Frontends}}</a></dd>
					{{with .GetSession}}<dt>Signed in</dt><dd>{{ago .GetCreation}}</dd>{{end}}
				</dl>
			</div>
		</div>
	</div>
	<div class="col-12 col-xl-6">
		<div class="q2a-panel h-100">
			<div class="q2a-panel-head">
				<span>SSH access</span>
				{{if .GetAllowSsh}}<span class="badge text-bg-success">allowed</span>{{else}}<span class="badge text-bg-secondary">not allowed</span>{{end}}
			</div>
			<div class="q2a-panel-body">
				{{if .GetAllowSsh}}
				<p class="mb-2">Manage your servers from a terminal:</p>
				<pre class="q2a-mono bg-body-tertiary p-2 rounded text-wrap mb-3">ssh -p &lt;ssh port&gt; {{.GetEmail}}@&lt;this host&gt;</pre>
				{{end}}
				{{if .GetPublicKey}}
				<label class="form-label small text-body-secondary" for="sshkey">Public key on file</label>
				<textarea id="sshkey" class="form-control q2a-mono" rows="3" readonly>{{.GetPublicKey}}</textarea>
				{{else}}
				<p class="mb-0 text-body-secondary">No SSH public key on file.</p>
				{{end}}
			</div>
		</div>
	</div>
</div>
{{end}}
{{template "footer" .}}
{{end}}
