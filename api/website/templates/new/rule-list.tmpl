{{define "rule-list"}}
{{template "header" .}}
{{$fe := .Frontend}}
{{$base := printf "/sv/%s/%s" $fe.UUID $fe.Name}}
<div class="q2a-page-head">
	<div class="min-w-0">
		<nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a href="/my-servers">Servers</a></li><li class="breadcrumb-item"><a href="{{$base}}#rules">{{$fe.Name}}</a></li><li class="breadcrumb-item active" aria-current="page">Rules</li></ol></nav>
		<h1>Rules</h1>
	</div>
	<a class="btn btn-primary btn-sm" href="{{$base}}/rules/add"><i class="bi bi-plus-lg me-1"></i>New rule</a>
</div>

{{with .Notice}}<div class="alert alert-{{.Class}} alert-dismissible fade show" role="status">{{.Text}}<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div>{{end}}

<div class="q2a-panel">
	{{if .Rules}}
	<div class="table-responsive">
		<table class="table table-hover align-middle">
			<thead>
				<tr>
					<th>Type</th>
					<th>Description</th>
					<th class="d-none d-md-table-cell">Matches</th>
					<th class="d-none d-lg-table-cell">Expires</th>
					<th class="d-none d-sm-table-cell">ID</th>
				</tr>
			</thead>
			<tbody>
			{{range .Rules}}
				<tr>
					<td class="text-nowrap"><span class="badge text-bg-secondary">{{.GetType}}</span>{{if .GetDisabled}} <span class="badge text-bg-warning">off</span>{{end}}</td>
					<td><a href="/rules/{{.GetUuid}}/view" class="text-decoration-none">{{with .GetDescription}}{{join . " "}}{{else}}<span class="text-body-secondary">no description</span>{{end}}</a></td>
					<td class="d-none d-md-table-cell q2a-mono small text-break">
						{{range .GetAddress}}{{.}} {{end}}{{range .GetName}}name:{{.}} {{end}}{{range .GetHostname}}host:{{.}} {{end}}{{range .GetClient}}client:{{.}} {{end}}{{if .GetVpn}}vpn{{end}}
					</td>
					<td class="d-none d-lg-table-cell text-body-secondary text-nowrap">{{with .GetExpirationTime}}{{datetime .}}{{else}}never{{end}}</td>
					<td class="d-none d-sm-table-cell q2a-mono">{{printf "%.8s" .GetUuid}}</td>
				</tr>
			{{end}}
			</tbody>
		</table>
	</div>
	{{else}}
	<div class="q2a-empty">
		<p>No rules for {{$fe.Name}} yet.</p>
		<a class="btn btn-primary btn-sm" href="{{$base}}/rules/add">Create a rule</a>
	</div>
	{{end}}
</div>
{{template "footer" .}}
{{end}}
