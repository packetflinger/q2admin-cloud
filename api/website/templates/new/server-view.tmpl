{{define "server-view"}}
{{template "header" .}}
{{$fe := .Frontend}}
{{$up := and $fe.Connected $fe.Trusted}}
{{$base := printf "/sv/%s/%s" $fe.UUID $fe.Name}}
<div class="q2a-page-head">
	<div class="min-w-0">
		<nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a href="/my-servers">Servers</a></li><li class="breadcrumb-item active" aria-current="page">{{$fe.Name}}</li></ol></nav>
		<h1 class="text-truncate">
			<span class="q2a-dot {{if $up}}online{{end}} me-1"></span>
			{{$fe.Name}}
			{{if $up}}<span class="badge text-bg-success fs-6 align-middle">online</span>{{else}}<span class="badge text-bg-secondary fs-6 align-middle">offline</span>{{end}}
			{{if not $fe.Enabled}}<span class="badge text-bg-warning fs-6 align-middle">disabled</span>{{end}}
			{{if not .CanEdit}}<span class="badge text-bg-info fs-6 align-middle" title="Shared with you by {{$fe.Owner}}">shared</span>{{end}}
		</h1>
	</div>
	<div class="d-flex flex-wrap gap-2">
		<a class="btn btn-sm btn-outline-secondary" href="quake2://{{$fe.IPAddress}}:{{$fe.Port}}"><i class="bi bi-controller me-1"></i>Join</a>
		{{if $up}}<a class="btn btn-sm btn-primary" href="{{$base}}/console"><i class="bi bi-terminal me-1"></i>Console</a>{{end}}
	</div>
</div>

{{with .Notice}}<div class="alert alert-{{.Class}} alert-dismissible fade show" role="status">{{.Text}}<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div>{{end}}
{{if .FormError}}<div class="alert alert-danger" role="alert">Settings not saved: {{.FormError}}</div>{{end}}

<form class="mb-3" method="get" action="/search/{{$fe.UUID}}" role="search">
	<div class="input-group">
		<span class="input-group-text"><i class="bi bi-search"></i></span>
		<input type="search" name="q" class="form-control" placeholder="Search this server's players: name, IP, hostname, userinfo" aria-label="Search players">
		<button class="btn btn-outline-secondary" type="submit">Search</button>
	</div>
</form>

<ul class="nav nav-tabs flex-nowrap overflow-x-auto overflow-y-hidden" role="tablist" data-q2a-remember>
	<li class="nav-item" role="presentation"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#overview" type="button" role="tab" aria-controls="overview" aria-selected="true">Overview</button></li>
	<li class="nav-item" role="presentation"><button class="nav-link text-nowrap" data-bs-toggle="tab" data-bs-target="#players" type="button" role="tab" aria-controls="players" aria-selected="false">Players {{if $up}}<span class="badge text-bg-secondary">{{online $fe}}</span>{{end}}</button></li>
	<li class="nav-item" role="presentation"><button class="nav-link text-nowrap" data-bs-toggle="tab" data-bs-target="#rules" type="button" role="tab" aria-controls="rules" aria-selected="false">Rules <span class="badge text-bg-secondary">{{len $fe.Rules}}</span></button></li>
	<li class="nav-item" role="presentation"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#stats" type="button" role="tab" aria-controls="stats" aria-selected="false">Stats</button></li>
	{{if .CanEdit}}<li class="nav-item" role="presentation"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#settings" type="button" role="tab" aria-controls="settings" aria-selected="false">Settings</button></li>{{end}}
</ul>

<div class="tab-content pt-3">
	<!-- Overview -->
	<div class="tab-pane fade show active" id="overview" role="tabpanel" tabindex="0">
		{{if $up}}
		<div class="row g-3">
			<div class="col-12 col-xl-6">
				<div class="q2a-panel h-100">
					<div class="q2a-panel-head">Status</div>
					<div class="q2a-panel-body">
						<dl class="q2a-kv">
							<dt>Peer</dt><dd class="q2a-mono">{{$fe.Connection.RemoteAddr.String}} {{if $fe.Encrypted}}<i class="bi bi-lock-fill text-success" title="encrypted"></i><span class="visually-hidden">encrypted</span>{{end}}</dd>
							<dt>Connected</dt><dd>{{ago $fe.ConnectTime}}</dd>
							<dt>Map</dt><dd class="q2a-mono">{{$fe.CurrentMap}}{{if $fe.PreviousMap}} <span class="text-body-secondary">(previous: {{$fe.PreviousMap}})</span>{{end}}</dd>
							<dt>Players</dt><dd>{{online $fe}} / {{$fe.MaxPlayers}}</dd>
							<dt>q2admin</dt><dd>version {{$fe.Version}}</dd>
							<dt>DM flags</dt><dd class="small">{{with index $fe.ServerVars "dmflags"}}{{dmflags .}}{{else}}-{{end}}</dd>
							<dt>Teleports</dt><dd>{{$fe.TeleportCount}}</dd>
							<dt>Invites</dt><dd>{{$fe.Invites.UseCount}}</dd>
						</dl>
					</div>
				</div>
			</div>
			<div class="col-12 col-xl-6">
				<div class="q2a-panel mb-3">
					<div class="q2a-panel-head">Change map</div>
					<form class="q2a-panel-body" method="post" action="{{$base}}/map">
						<div class="input-group">
							<input type="text" class="form-control q2a-mono" name="map" placeholder="q2dm1" required pattern="[A-Za-z0-9_/\-]{1,64}" aria-label="Map name">
							<button class="btn btn-primary" type="submit">Change</button>
						</div>
					</form>
				</div>
				<div class="q2a-panel">
					<div class="q2a-panel-head">Server variables</div>
					{{if $fe.ServerVars}}
					<div class="table-responsive">
						<table class="table table-sm">
							<tbody>
							{{range $k, $v := $fe.ServerVars}}
								<tr><th class="fw-normal text-body-secondary">{{$k}}</th><td class="q2a-mono text-break">{{$v}}</td></tr>
							{{end}}
							</tbody>
						</table>
					</div>
					{{else}}<div class="q2a-empty">No variables reported yet.</div>{{end}}
				</div>
			</div>
		</div>
		{{else}}
		<div class="q2a-panel q2a-empty">
			<p class="mb-1"><i class="bi bi-plug fs-3"></i></p>
			<p class="mb-1">This server isn't connected to CloudAdmin.</p>
			<p class="small mb-0">Check that its q2admin config uses UUID <span class="q2a-mono">{{$fe.UUID}}</span> and that its public key is set on the Settings tab.</p>
		</div>
		{{end}}
	</div>

	<!-- Players -->
	<div class="tab-pane fade" id="players" role="tabpanel" tabindex="0">
		<div class="q2a-panel">
			{{if and $up (online $fe)}}
			<div class="table-responsive">
				<table class="table table-hover align-middle">
					<thead><tr><th>#</th><th>Name</th><th class="d-none d-md-table-cell">Address</th><th class="text-end">Frags</th><th class="d-none d-sm-table-cell">Joined</th></tr></thead>
					<tbody>
					{{range $fe.Players}}{{if .ConnectTime}}
						<tr>
							<td class="q2a-mono">{{.ClientID}}</td>
							<td><a href="{{$base}}/player/{{.ClientID}}" class="text-decoration-none">{{.Name}}</a>{{if .VPN}} <span class="badge text-bg-warning">VPN</span>{{end}}{{if .Muted}} <span class="badge text-bg-secondary">muted</span>{{end}}</td>
							<td class="d-none d-md-table-cell q2a-mono">{{.IP}}</td>
							<td class="text-end">{{.Frags}}</td>
							<td class="d-none d-sm-table-cell text-body-secondary">{{ago .ConnectTime}}</td>
						</tr>
					{{end}}{{end}}
					</tbody>
				</table>
			</div>
			{{else}}
			<div class="q2a-empty">{{if $up}}Nobody is playing right now.{{else}}The server is offline.{{end}}</div>
			{{end}}
		</div>
	</div>

	<!-- Rules -->
	<div class="tab-pane fade" id="rules" role="tabpanel" tabindex="0">
		<div class="q2a-panel">
			<div class="q2a-panel-head">
				<span>Rules for this server</span>
				<a class="btn btn-sm btn-outline-secondary" href="{{$base}}/rules">Manage rules</a>
			</div>
			{{if $fe.Rules}}
			<div class="table-responsive">
				<table class="table table-hover align-middle">
					<thead><tr><th>ID</th><th>Type</th><th>Description</th></tr></thead>
					<tbody>
					{{range $fe.Rules}}
						<tr>
							<td class="q2a-mono"><a href="/rules/{{.GetUuid}}/view">{{printf "%.8s" .GetUuid}}</a></td>
							<td><span class="badge text-bg-secondary">{{.GetType}}</span></td>
							<td>{{join .GetDescription " "}}</td>
						</tr>
					{{end}}
					</tbody>
				</table>
			</div>
			{{else}}<div class="q2a-empty">No rules apply to this server.</div>{{end}}
		</div>
	</div>

	<!-- Stats -->
	<div class="tab-pane fade" id="stats" role="tabpanel" tabindex="0">
		{{template "stats" .Stats}}
	</div>

	<!-- Settings: owner only -->
	{{if .CanEdit}}
	<div class="tab-pane fade" id="settings" role="tabpanel" tabindex="0">
		<div class="row g-3">
			<div class="col-12 col-xl-6">
				<form class="q2a-panel" method="post" action="{{$base}}/edit">
					<div class="q2a-panel-head">General</div>
					<div class="q2a-panel-body">
						<div class="mb-3">
							<label for="servername" class="form-label">Name</label>
							<input type="text" class="form-control" id="servername" name="servername" value="{{$fe.Name}}" required maxlength="32">
						</div>
						<div class="row g-3 mb-3">
							<div class="col-12 col-sm-8">
								<label for="serveraddr" class="form-label">IP address or hostname</label>
								<input type="text" class="form-control q2a-mono" id="serveraddr" name="serveraddr" value="{{$fe.IPAddress}}" required>
							</div>
							<div class="col-12 col-sm-4">
								<label for="serverport" class="form-label">Port</label>
								<input type="number" class="form-control q2a-mono" id="serverport" name="serverport" value="{{$fe.Port}}" min="1" max="65535">
							</div>
						</div>
						<div class="form-check form-switch mb-2">
							<input class="form-check-input" type="checkbox" role="switch" id="switchEnabled" name="switchenabled" {{if $fe.Enabled}}checked{{end}}>
							<label class="form-check-label" for="switchEnabled">Enabled</label>
						</div>
						<div class="form-check form-switch mb-2">
							<input class="form-check-input" type="checkbox" role="switch" id="switchTeleport" name="switchteleport" {{if $fe.AllowTeleport}}checked{{end}}>
							<label class="form-check-label" for="switchTeleport">Allow players to teleport to other servers</label>
						</div>
						<div class="form-check form-switch mb-2">
							<input class="form-check-input" type="checkbox" role="switch" id="switchInvite" name="switchinvite" {{if $fe.AllowInvite}}checked{{end}}>
							<label class="form-check-label" for="switchInvite">Allow player invite broadcasts</label>
						</div>
						<div class="form-check form-switch">
							<input class="form-check-input" type="checkbox" role="switch" id="switchProtect" name="switchprotect" {{if $fe.DeleteProtect}}checked{{end}}>
							<label class="form-check-label" for="switchProtect">Delete protection</label>
						</div>
					</div>
					<div class="q2a-panel-foot text-end">
						<input type="hidden" name="uuid" value="{{$fe.UUID}}">
						<button type="submit" class="btn btn-primary">Save</button>
					</div>
				</form>
			</div>

			<div class="col-12 col-xl-6">
				<form class="q2a-panel mb-3" method="post" action="{{$base}}/manage-keys">
					<div class="q2a-panel-head">
						<span>Public key</span>
						<a class="small fw-normal" href="{{$base}}/manage-keys">Generate a key pair</a>
					</div>
					<div class="q2a-panel-body">
						<label for="keydata" class="form-label small text-body-secondary">The PEM public key matching the private key on your Quake 2 server.</label>
						<textarea class="form-control q2a-mono" rows="6" id="keydata" name="keydata" placeholder="-----BEGIN PUBLIC KEY-----" required>{{$fe.PublicKeyData}}</textarea>
					</div>
					<div class="q2a-panel-foot text-end">
						<input type="hidden" name="uuid" value="{{$fe.UUID}}">
						<input type="hidden" name="srvname" value="{{$fe.Name}}">
						<input type="hidden" name="action" value="SaveKey">
						<button type="submit" class="btn btn-primary">Save key</button>
					</div>
				</form>

				<div class="q2a-panel mb-3">
					<div class="q2a-panel-head">Server ID</div>
					<div class="q2a-panel-body">
						<p class="q2a-mono text-break mb-2">{{$fe.UUID}}</p>
						<p class="small text-body-secondary">Regenerate it if someone else knows it. The server disconnects until its q2admin config is updated.</p>
						<button class="btn btn-sm btn-outline-warning" type="button" data-bs-toggle="modal" data-bs-target="#changeuuid">Generate new ID</button>
					</div>
				</div>

				<div class="q2a-panel mb-3">
					<div class="q2a-panel-head">Shared with</div>
					<div class="q2a-panel-body">
						<p class="small text-body-secondary">These users can see players, stats and the console, manage rules and players, but can't change settings or delete the server.</p>
						{{if $fe.Delegates}}
						<ul class="list-group list-group-flush mb-3">
							{{range $fe.Delegates}}
							<li class="list-group-item bg-transparent px-0 d-flex align-items-center justify-content-between gap-2">
								<span class="text-break">{{.}}</span>
								<form method="post" action="{{$base}}/delegates" data-q2a-confirm="Remove {{.}}'s access?">
									<input type="hidden" name="email" value="{{.}}">
									<button class="btn btn-sm btn-outline-secondary" type="submit" name="action" value="remove" aria-label="Remove {{.}}">Remove</button>
								</form>
							</li>
							{{end}}
						</ul>
						{{end}}
						<form method="post" action="{{$base}}/delegates">
							<label class="form-label" for="delegate-email">Share with</label>
							<div class="input-group">
								<input type="email" class="form-control" id="delegate-email" name="email" required placeholder="their sign-in email">
								<button class="btn btn-primary" type="submit" name="action" value="add">Share</button>
							</div>
						</form>
					</div>
				</div>

				<div class="q2a-panel q2a-danger">
					<div class="q2a-panel-head">Danger zone</div>
					<div class="q2a-panel-body d-flex flex-wrap align-items-center justify-content-between gap-2">
						<span class="small">{{if $fe.DeleteProtect}}Turn off delete protection to delete this server.{{else}}Delete this server and its history.{{end}}</span>
						<button class="btn btn-sm btn-danger" type="button" data-bs-toggle="modal" data-bs-target="#deletefrontend" {{if $fe.DeleteProtect}}disabled{{end}}>Delete server</button>
					</div>
				</div>
			</div>
		</div>
	</div>
	{{end}}
</div>

{{if .CanEdit}}
<div class="modal fade" id="changeuuid" tabindex="-1" aria-labelledby="changeuuid-title" aria-hidden="true">
	<div class="modal-dialog modal-dialog-centered">
		<form class="modal-content" method="post" action="{{$base}}/change-uuid">
			<div class="modal-header">
				<h5 class="modal-title" id="changeuuid-title">Generate a new ID?</h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<div class="modal-body">
				<p>The server will disconnect from CloudAdmin until its q2admin config is updated with the new ID. This can't be undone.</p>
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
				<button type="submit" class="btn btn-warning">Generate new ID</button>
			</div>
		</form>
	</div>
</div>

<div class="modal fade" id="deletefrontend" tabindex="-1" aria-labelledby="deletefrontend-title" aria-hidden="true">
	<div class="modal-dialog modal-dialog-centered">
		<form class="modal-content" method="post" action="{{$base}}/delete">
			<div class="modal-header">
				<h5 class="modal-title" id="deletefrontend-title">Delete {{$fe.Name}}?</h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<div class="modal-body">
				<p>Its history, statistics and logs are deleted and it stops being a teleport destination.</p>
				<p class="mb-0"><strong>This can't be undone.</strong></p>
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
				<button type="submit" class="btn btn-danger">Delete server</button>
			</div>
		</form>
	</div>
</div>
{{end}}
{{template "footer" .}}
{{end}}
