{{define "search"}}
{{template "header" .}}
<div class="q2a-page-head">
	<div class="min-w-0">
		{{with .Frontend}}<nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a href="/my-servers">Servers</a></li><li class="breadcrumb-item"><a href="/sv/{{.UUID}}/{{.Name}}">{{.Name}}</a></li><li class="breadcrumb-item active" aria-current="page">Search</li></ol></nav>{{end}}
		<h1>{{if .Frontend}}Search {{.Frontend.Name}}{{else}}Search all servers{{end}}</h1>
	</div>
</div>

<form class="mb-3" method="get" action="{{with .Frontend}}/search/{{.UUID}}{{else}}/search{{end}}" role="search">
	<div class="input-group">
		<span class="input-group-text"><i class="bi bi-search"></i></span>
		<input type="search" name="q" value="{{.SearchQuery}}" class="form-control" placeholder="Name, IP, hostname, client version or userinfo" aria-label="Search players" autofocus>
		<button class="btn btn-primary" type="submit">Search</button>
	</div>
	<div class="form-text">Matches anywhere in the text. One row per name and IP address, up to 200 players, most recently seen first.</div>
</form>

{{if .SearchQuery}}
<div class="q2a-panel">
	<div class="q2a-panel-head">{{len .SearchResults}} player{{if ne (len .SearchResults) 1}}s{{end}} matching "{{.SearchQuery}}"</div>
	{{if .SearchResults}}
	<div class="table-responsive">
		<table class="table table-hover align-middle">
			<thead>
				<tr>
					<th>Name</th>
					<th>IP</th>
					{{if not $.Frontend}}<th class="d-none d-sm-table-cell">Servers</th>{{end}}
					<th class="d-none d-lg-table-cell">Hostname</th>
					<th class="d-none d-xl-table-cell">Clients</th>
					<th class="text-end d-none d-sm-table-cell">Visits</th>
					<th class="d-none d-md-table-cell">Last seen</th>
				</tr>
			</thead>
			<tbody>
			{{range .SearchResults}}
				<tr>
					<td><a href="/player/{{.Lookup}}" class="text-decoration-none">{{.Name}}</a>{{if .VPN}} <span class="badge text-bg-warning">VPN</span>{{end}}</td>
					<td class="q2a-mono">{{.IP}}</td>
					{{if not $.Frontend}}<td class="d-none d-sm-table-cell">{{range $i, $s := .Servers}}{{if $i}}, {{end}}{{index $.ServerNames $s}}{{end}}</td>{{end}}
					<td class="d-none d-lg-table-cell q2a-mono small text-break">{{range .Hostnames}}<div>{{.}}</div>{{end}}</td>
					<td class="d-none d-xl-table-cell">{{range .Versions}}<span class="badge text-bg-secondary q2a-mono fw-normal me-1">{{.}}</span>{{end}}</td>
					<td class="text-end d-none d-sm-table-cell">{{.Visits}}</td>
					<td class="d-none d-md-table-cell text-body-secondary text-nowrap" title="{{datetime .ConnectTime}}">{{ago .ConnectTime}}</td>
				</tr>
			{{end}}
			</tbody>
		</table>
	</div>
	{{else}}<div class="q2a-empty">No players match.</div>{{end}}
</div>
{{end}}
{{template "footer" .}}
{{end}}
