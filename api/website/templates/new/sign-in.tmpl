<!doctype html>
<html lang="en" data-bs-theme="dark">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>Sign in | CloudAdmin</title>
	<script>try { document.documentElement.dataset.bsTheme = localStorage.getItem("q2a-theme") || "dark"; } catch (e) {}</script>
	<link rel="icon" href="/static/img/q2-48.png">
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
	<link href="/static/css/q2a.css" rel="stylesheet">
</head>
<body class="d-flex align-items-center justify-content-center px-3">
	<main class="w-100" style="max-width: 380px">
		<div class="text-center mb-4">
			<img src="/static/img/q2-48.png" width="56" height="56" alt="">
			<h1 class="h4 mt-3 mb-1">CloudAdmin</h1>
			<p class="text-body-secondary">Sign in to manage your Quake 2 servers</p>
		</div>
		<div class="q2a-panel">
			<div class="q2a-panel-body d-grid gap-2">
				{{range .AuthProviders}}{{if .Enabled}}
				<a class="btn btn-outline-secondary btn-lg d-flex align-items-center justify-content-center gap-2" href="{{.URL}}">
					<img src="{{.Icon}}" width="24" height="24" alt=""> {{.Alt}}
				</a>
				{{end}}{{else}}
				<p class="text-center text-body-secondary mb-0">No sign-in providers are configured.</p>
				{{end}}
			</div>
		</div>
		<p class="text-center small mt-3"><a href="/privacy-policy">Privacy</a> &middot; <a href="/terms-of-use">Terms</a></p>
	</main>
</body>
</html>
