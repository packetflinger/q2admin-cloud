<!doctype html>
<html lang="en" data-bs-theme="dark">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>Sign in | CloudAdmin</title>
	<script>try { document.documentElement.dataset.bsTheme = localStorage.getItem("q2a-theme") || "dark"; } catch (e) {}</script>
	<link rel="icon" href="/static/img/q2-48.png">
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
	<link href="/static/css/q2a.css" rel="stylesheet">
</head>
<body class="q2a-signin">
	<main class="q2a-signin-card">
		<img class="q2a-signin-logo" src="/static/img/q2-48.png" width="72" height="72" alt="">
		<h1>CloudAdmin</h1>
		<p class="q2a-signin-tag">Command your Quake 2 servers.</p>
		<div class="d-grid gap-2">
			{{range .AuthProviders}}{{if .Enabled}}
			<a class="q2a-provider q2a-provider-{{.Name}}" href="{{.URL}}" title="{{.Alt}}">
				<img src="{{.Icon}}" width="22" height="22" alt=""> Continue with {{.Name}}
			</a>
			{{end}}{{else}}
			<p class="text-body-secondary mb-0">No sign-in providers are set up.</p>
			{{end}}
		</div>
	</main>
	<footer class="q2a-signin-foot">By signing in you agree to the <a href="/terms-of-use">Terms</a> and <a href="/privacy-policy">Privacy policy</a>.</footer>
</body>
</html>
