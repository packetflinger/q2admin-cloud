{{define "terminal"}}
{{template "header" .}}
{{$fe := .Frontend}}
{{$base := printf "/sv/%s/%s" $fe.UUID $fe.Name}}
<link href="/static/node_modules/xterm/css/xterm.css" rel="stylesheet">
<div class="q2a-page-head">
	<div>
		<nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a href="/my-servers">Servers</a></li><li class="breadcrumb-item"><a href="{{$base}}">{{$fe.Name}}</a></li><li class="breadcrumb-item active" aria-current="page">Console</li></ol></nav>
		<h1>Console</h1>
	</div>
	<span id="console-status" class="badge text-bg-secondary" role="status">connecting...</span>
</div>

{{if and $fe.Connected $fe.Trusted}}
<div class="q2a-panel overflow-hidden">
	<div id="console" class="q2a-console" data-stream="{{$base}}/console/stream" aria-label="Server console output"></div>
	<form id="console-form" class="q2a-panel-foot" data-command="{{$base}}/console/command" autocomplete="off">
		<div class="input-group">
			<span class="input-group-text q2a-mono">&gt;</span>
			<input id="console-input" type="text" name="cmd" class="form-control q2a-mono" maxlength="256" placeholder="status" aria-label="Console command" autofocus>
			<button class="btn btn-primary" type="submit">Send</button>
		</div>
		<div class="form-text">Runs on the server console as if typed there. Up and down arrows recall earlier commands.</div>
	</form>
</div>
<script src="/static/node_modules/xterm/lib/xterm.js"></script>
<script src="https://cdn.jsdelivr.net/npm/xterm-addon-fit@0.6.0/lib/xterm-addon-fit.js"></script>
<script src="/static/js/console.js" defer></script>
{{else}}
<div class="q2a-panel q2a-empty">The server is offline, so there's no console to show. <a href="{{$base}}">Back to {{$fe.Name}}</a></div>
{{end}}
{{template "footer" .}}
{{end}}
