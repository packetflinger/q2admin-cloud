{{define "player"}}
{{template "header" .}}
{{with .PlayerDBInfo}}
{{$server := index $.ServerNames .ServerUUID}}
<div class="q2a-page-head">
	<div class="min-w-0">
		<nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a href="/search">Search</a></li><li class="breadcrumb-item active" aria-current="page">Player record</li></ol></nav>
		<h1 class="text-truncate">{{.Name}}</h1>
	</div>
	<a class="btn btn-sm btn-outline-secondary" href="/search/{{.ServerUUID}}?q={{.IP}}"><i class="bi bi-search me-1"></i>Other visits from this IP</a>
</div>

<div class="row g-3">
	<div class="col-12 col-xl-6">
		<div class="q2a-panel">
			<div class="q2a-panel-head">
				<span>Visit</span>
				{{if .Vpn}}<span class="badge text-bg-warning">VPN</span>{{end}}
			</div>
			<div class="q2a-panel-body">
				<dl class="q2a-kv">
					<dt>Server</dt><dd><a href="/sv/{{.ServerUUID}}/{{$server}}">{{$server}}</a></dd>
					<dt>Seen</dt><dd>{{datetime .ConnectTime}} <span class="text-body-secondary">({{ago .ConnectTime}})</span></dd>
					<dt>Name</dt><dd class="q2a-mono">"{{.Name}}"</dd>
					<dt>IP</dt><dd class="q2a-mono">{{.IP}}</dd>
					<dt>Hostname</dt><dd class="q2a-mono">{{or .Hostname "-"}}</dd>
					<dt>Client</dt><dd class="q2a-mono">{{or .Version "-"}}</dd>
					<dt>Cookie</dt><dd class="q2a-mono">{{or .Cookie "-"}}</dd>
				</dl>
			</div>
		</div>
	</div>
	<div class="col-12 col-xl-6">
		<div class="q2a-panel">
			<div class="q2a-panel-head">Userinfo</div>
			{{with userinfo .Userinfo}}
			<div class="table-responsive">
				<table class="table table-sm">
					<tbody>{{range $k, $v := .}}<tr><th class="fw-normal text-body-secondary">{{$k}}</th><td class="q2a-mono text-break">{{$v}}</td></tr>{{end}}</tbody>
				</table>
			</div>
			{{else}}<div class="q2a-empty">No userinfo recorded.</div>{{end}}
		</div>
	</div>
</div>
{{end}}
{{template "footer" .}}
{{end}}
